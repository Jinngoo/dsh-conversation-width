{
  "name": "@jinngoo/dsh-conversation-width",
  "version": "0.1.1",
  "description": "DSH Web UI 插件：加宽会话内容列，并在输入框下方给出宽度滑杆（不装也能用内置拖拽手柄）。Widens the Harness Web conversation content column and adds a width slider under the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jinngoo/dsh-conversation-width.git"
  },
  "homepage": "https://github.com/Jinngoo/dsh-conversation-width#readme",
  "bugs": {
    "url": "https://github.com/Jinngoo/dsh-conversation-width/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "web-ui",
    "layout",
    "width"
  ]
}
